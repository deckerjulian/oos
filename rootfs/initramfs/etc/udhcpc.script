#!/bin/sh
# Copyright (C) 2026 Julian Decker
# SPDX-License-Identifier: GPL-2.0-or-later
# wlan0 stays behind eth0 when both have a default route
metric=
[ "$interface" = wlan0 ] && metric="metric 20"
# the NTP servers of the lease (DHCP option 42, asked for with `-O ntpsrv`), space separated, for System > Date and
# time > NTP server = DHCP (oos-ui reads the file at each request); no file while there are none
ntpf=/tmp/oos-dhcp-ntp.$interface
# the POSIX time zone of the lease (DHCP option 100, RFC 4833, asked for with `-O tzstr`) for `tz = dhcp`; written as
# it came, never run: oos-ui takes it only when it is a valid zone (sysconf::tz_of)
tzf=/tmp/oos-dhcp-tz.$interface
case "$1" in
deconfig)
	[ "$interface" = wlan0 ] && ip -4 addr flush dev "$interface"
	rm -f "$ntpf" "$tzf"
	;;
bound|renew)
	if [ -n "$ntpsrv" ]; then
		echo "$ntpsrv" > "$ntpf.new" && mv "$ntpf.new" "$ntpf"
	else
		rm -f "$ntpf"
	fi
	if [ -n "$tzstr" ]; then
		printf '%s\n' "$tzstr" | head -c 256 > "$tzf.new" && mv "$tzf.new" "$tzf"
	else
		rm -f "$tzf"
	fi
	# a renewal of the same address changes nothing (a flush would cut the connections for a moment)
	[ "$1" = renew ] && ip -4 addr show dev "$interface" | grep -q "inet $ip/" && exit 0
	# IPv4 only: a flush of every family took the IPv6 link-local address too, which the kernel makes only when the
	# link comes up, and with it SLAAC and IPv6 mDNS
	ip -4 addr flush dev "$interface"
	ip addr add "$ip/${mask:-24}" dev "$interface"
	[ -n "$router" ] && ip route add default via ${router%% *} dev "$interface" $metric
	: > /etc/resolv.conf; for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
	;;
esac
