# Select OOS for the next boot: replace "KRNL" at the start of `boot` with "OOSK" (see oos-oneshot).
dev=/dev/mmcblk0; BOOT_LBA=122880
[ "$(dd if=$dev bs=512 skip=$BOOT_LBA count=1 2>/dev/null | head -c 4)" = KRNL ] || { echo "boot magic is not KRNL, nothing changed"; exit 1; }
dd if=$dev bs=512 skip=$BOOT_LBA count=1 of=/tmp/bootsec 2>/dev/null
{ printf 'OOSK'; tail -c 508 /tmp/bootsec; } > /tmp/bootsec.new
dd if=/tmp/bootsec.new of=$dev bs=512 seek=$BOOT_LBA count=1 conv=notrunc,fsync 2>/dev/null && sync && echo "next boot: OOS"
