#!/bin/sh
# Copyright (C) 2026 Julian Decker
# SPDX-License-Identifier: GPL-2.0-or-later
# Mount the stock `rigol` partition (calibration files in /rigol/data) READ ONLY at /rigol, so oos-fpgad / oos-ui find
# cal_*.hex at their default OOS_CAL_DIR. The OOS kernel does not parse the Rockchip PARM table, so the partition is
# reached through a read-only loop device: PARM entry 0x000FA000@0x004CE440(rigol), offsets relative to LBA 0x2000
# -> LBA 0x4D0440 = 5047360, 500 MiB (checked on the card clone of 2026-11-02: ext4, label "rigol"). `noload` skips the journal replay, so nothing is ever written to the card.
LBA=5047360
DEV=${1:-/dev/mmcblk0}
grep -q ' /rigol ' /proc/mounts && { echo "/rigol already mounted"; exit 0; }
# ext4 superblock at +1024, magic 0xef53 at +56 of it
magic=$(dd if=$DEV bs=512 skip=$((LBA + 2)) count=1 2>/dev/null | od -An -tx1 -j56 -N2 | tr -d ' ')
label=$(dd if=$DEV bs=512 skip=$((LBA + 2)) count=1 2>/dev/null | dd bs=1 skip=120 count=5 2>/dev/null)
[ "$magic" = 53ef ] && [ "$label" = rigol ] || { echo "oos-mount-rigol: no ext4 'rigol' at LBA $LBA of $DEV (magic '$magic', label '$label'), not mounting"; exit 1; }
mkdir -p /rigol
loop=$(losetup -f) || exit 1
losetup -r -o $((LBA * 512)) "$loop" "$DEV" || exit 1
mount -t ext4 -o ro,noload "$loop" /rigol || { losetup -d "$loop"; exit 1; }
ls /rigol/data/cal_*.hex 2>/dev/null || echo "oos-mount-rigol: mounted, but no cal_*.hex in /rigol/data"
