echo "================ OOS development image ================"
echo "build:   $(cat /etc/oos-build)"
echo "kernel:  $(uname -r)"
echo "model:   $(tr -d '\000' < /proc/device-tree/model)"
echo "eth0:    $(ip -4 addr show eth0 2>/dev/null | awk '/inet /{print $2}')"
echo "access:  ssh root@<ip>   (provisioned key only; console: oos-ssh add FILE)"
echo "stock:   power-cycle (boot magic restored at start)"
echo "again:   oos-boot-oos-again && reboot"
echo "update:  oos-update status   (install: http://<ip>:8080/update)"
echo "========================================================"
