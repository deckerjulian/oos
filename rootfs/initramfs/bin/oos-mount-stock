#!/bin/sh
# Copyright (C) 2026 Julian Decker
# SPDX-License-Identifier: GPL-2.0-or-later
# Mount the stock data partition (calibration files in /rigol/data) READ ONLY at /rigol, so oos-fpgad / oos-ui find
# cal_*.hex at their default OOS_CAL_DIR. The OOS kernel does not parse the PARM table, so the partition is
# reached through a read-only loop device at the board's OOS_STOCK_LBA (/etc/oos-board; DHO800/DHO900 checked on the card
# clone of 2026-11-02: ext4, magic 0xef53). `noload` skips the journal replay, so nothing is ever written to the card.
. "${OOS_BOARD_FILE:-/etc/oos-board}"
LBA=$OOS_STOCK_LBA
DEV=${1:-/dev/mmcblk0}
grep -q ' /rigol ' /proc/mounts && { echo "/rigol already mounted"; exit 0; }
# ext4 superblock at +1024, magic 0xef53 at +56 of it
magic=$(dd if=$DEV bs=512 skip=$((LBA + 2)) count=1 2>/dev/null | od -An -tx1 -j56 -N2 | tr -d ' ')
label=$(dd if=$DEV bs=512 skip=$((LBA + 2)) count=1 2>/dev/null | dd bs=1 skip=120 count=5 2>/dev/null)
[ "$magic" = 53ef ] && [ "$label" = rigol ] || { echo "oos-mount-stock: no ext4 'rigol' at LBA $LBA of $DEV (magic '$magic', label '$label'), not mounting"; exit 1; }
mkdir -p /rigol
loop=$(losetup -f) || exit 1
losetup -r -o $((LBA * 512)) "$loop" "$DEV" || exit 1
mount -t ext4 -o ro,noload "$loop" /rigol || { losetup -d "$loop"; exit 1; }
ls /rigol/data/cal_*.hex 2>/dev/null || echo "oos-mount-stock: mounted, but no cal_*.hex in /rigol/data"
